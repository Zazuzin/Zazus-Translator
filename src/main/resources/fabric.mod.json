{
  "schemaVersion": 1,
  "id": "zazu_translate",
  "version": "${version}",
  "name": "Zazu's Translator",
  "description": "Automatic and manual client-side Minecraft chat translation.",
  "authors": [
    "Zazuzin"
  ],
  "contact": {
    "sources": "https://github.com/Zazuzin/Zazus-Translator",
    "issues": "https://github.com/Zazuzin/Zazus-Translator/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "uk.co.zazuzin.translate.ZazuTranslateClient"
    ]
  },
  "mixins": [
    {
      "config": "zazu-translate.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}

